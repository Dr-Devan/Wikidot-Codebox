[[html]]
<style>
@import url("https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0");

html,
body {
  margin: 0;
  padding: 0;
  background: transparent;
}

body {
  color: #c9d1d9;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  font-size: 13px;
  line-height: 1.55;
}

.material-symbols-outlined {
  font-family: "Material Symbols Outlined";
  font-weight: normal;
  font-style: normal;
  font-size: 20px;
  line-height: 1;
  display: inline-block;
  text-transform: none;
  letter-spacing: normal;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: "liga";
  -webkit-font-smoothing: antialiased;
  font-variation-settings:
    "FILL" 0,
    "wght" 400,
    "GRAD" 0,
    "opsz" 24;
}

.wd-decoder {
  --wd-bg: #0d1117;
  --wd-panel: #161b22;
  --wd-panel-2: #0f1520;
  --wd-border: #30363d;
  --wd-text: #c9d1d9;
  --wd-title: #f0f6fc;
  --wd-muted: #8b949e;
  --wd-button: #21262d;
  --wd-button-hover: #30363d;
  --wd-accent: #79c0ff;
  --wd-success: #3fb950;
  --wd-error: #ff7b72;
  --wd-token-format: #d2a8ff;

  border: 1px solid var(--wd-border);
  border-radius: 12px;
  overflow: hidden;
  background: var(--wd-bg);
  color: var(--wd-text);
}

.wd-decoder[data-theme="light"] {
  --wd-bg: #ffffff;
  --wd-panel: #f6f8fa;
  --wd-panel-2: #ffffff;
  --wd-border: #d0d7de;
  --wd-text: #333333;
  --wd-title: #333333;
  --wd-muted: #57606a;
  --wd-button: #f6f8fa;
  --wd-button-hover: #eaeef2;
  --wd-accent: #0969da;
  --wd-success: #1a7f37;
  --wd-error: #cf222e;
  --wd-token-format: #8250df;
}

.wd-decoder-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--wd-border);
  background: var(--wd-panel);
}

.wd-decoder-title {
  margin: 0;
  color: var(--wd-title);
  font-family: sans-serif;
  font-size: 14px;
  font-weight: 800;
}

.wd-decoder-subtitle {
  margin-top: 2px;
  color: var(--wd-muted);
  font-family: sans-serif;
  font-size: 11px;
}

.wd-decoder-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.wd-ui-lang-select {
  width: auto;
  min-width: 132px;
  height: 30px;
  padding: 0 8px;
  border: 1px solid var(--wd-border);
  border-radius: 8px;
  background: var(--wd-button);
  color: var(--wd-text);
  font-family: sans-serif;
  font-size: 12px;
}

.wd-decoder-body {
  display: grid;
  gap: 14px;
  padding: 14px;
}

.wd-decoder-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
  gap: 14px;
}

.wd-decoder-card {
  border: 1px solid var(--wd-border);
  border-radius: 10px;
  background: var(--wd-panel-2);
  overflow: hidden;
}

.wd-decoder-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--wd-border);
  background: var(--wd-panel);
}

.wd-decoder-card-title {
  color: var(--wd-title);
  font-family: sans-serif;
  font-size: 12px;
  font-weight: 700;
}

.wd-decoder-card-meta {
  color: var(--wd-muted);
  font-family: sans-serif;
  font-size: 11px;
}

.wd-decoder-controls {
  display: grid;
  gap: 10px;
  padding: 12px;
}

.wd-field {
  display: grid;
  gap: 6px;
}

.wd-label {
  color: var(--wd-muted);
  font-family: sans-serif;
  font-size: 11px;
  font-weight: 700;
}

.wd-select,
.wd-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid var(--wd-border);
  border-radius: 8px;
  background: var(--wd-bg);
  color: var(--wd-text);
  font-family: inherit;
  font-size: 13px;
  line-height: 1.55;
}

.wd-select {
  height: 34px;
  padding: 0 10px;
}

.wd-textarea {
  min-height: 92px;
  padding: 10px;
  resize: vertical;
}

.wd-textarea-source {
  min-height: 380px;
}

.wd-textarea-output {
  min-height: 500px;
}

.wd-select:focus,
.wd-textarea:focus,
.wd-ui-lang-select:focus {
  outline: 2px solid var(--wd-accent);
  outline-offset: 1px;
}

.wd-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.wd-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 32px;
  padding: 0 10px;
  border: 1px solid var(--wd-border);
  border-radius: 8px;
  background: var(--wd-button);
  color: var(--wd-text);
  font-family: sans-serif;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.wd-button:hover {
  background: var(--wd-button-hover);
}

.wd-button-primary {
  border-color: color-mix(in srgb, var(--wd-accent), var(--wd-border) 35%);
  color: var(--wd-accent);
}

.wd-button-success {
  color: var(--wd-success);
}

.wd-button-danger {
  color: var(--wd-error);
}

.wd-button .material-symbols-outlined {
  font-size: 17px;
}

.wd-note {
  padding: 10px 12px;
  border: 1px solid var(--wd-border);
  border-radius: 8px;
  background: var(--wd-panel);
  color: var(--wd-muted);
  font-family: sans-serif;
  font-size: 12px;
}

.wd-note strong {
  color: var(--wd-title);
}

.wd-token-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.wd-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 7px;
  border: 1px solid var(--wd-border);
  border-radius: 999px;
  background: var(--wd-bg);
  color: var(--wd-muted);
  font-family: sans-serif;
  font-size: 11px;
}

.wd-chip-accent {
  color: var(--wd-accent);
}

.wd-chip-format {
  color: var(--wd-token-format);
}

.wd-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  color: var(--wd-muted);
  font-family: sans-serif;
  font-size: 11px;
}

.wd-stat strong {
  color: var(--wd-title);
}

.wd-error-message {
  display: none;
  padding: 8px 10px;
  border: 1px solid color-mix(in srgb, var(--wd-error), var(--wd-border) 45%);
  border-radius: 8px;
  background: color-mix(in srgb, var(--wd-error), transparent 88%);
  color: var(--wd-error);
  font-family: sans-serif;
  font-size: 12px;
  font-weight: 700;
}

.wd-error-message.is-visible {
  display: block;
}

.wd-theme-switch {
  display: inline-flex;
  align-items: center;
  cursor: pointer;
  user-select: none;
}

.wd-theme-switch-input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.wd-theme-switch-track {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  width: 58px;
  height: 28px;
  padding: 0 6px;
  border: 1px solid var(--wd-border);
  border-radius: 999px;
  background: var(--wd-button);
  color: var(--wd-muted);
  box-sizing: border-box;
}

.wd-theme-switch:hover .wd-theme-switch-track {
  background: var(--wd-button-hover);
}

.wd-theme-switch-thumb {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 20px;
  height: 20px;
  border-radius: 999px;
  background: var(--wd-text);
  transition: transform 160ms ease, background 160ms ease;
  z-index: 2;
}

.wd-theme-switch-icon {
  position: relative;
  z-index: 1;
  font-size: 16px;
  line-height: 1;
}

.wd-theme-switch-input:checked + .wd-theme-switch-track .wd-theme-switch-thumb {
  transform: translateX(30px);
}

.wd-theme-switch-input:checked + .wd-theme-switch-track {
  color: var(--wd-accent);
}

.wd-toast {
  position: fixed;
  right: 16px;
  bottom: 16px;
  display: flex;
  align-items: center;
  gap: 7px;
  max-width: min(420px, calc(100vw - 32px));
  padding: 9px 12px;
  border: 1px solid var(--wd-border);
  border-radius: 9px;
  background: var(--wd-panel);
  color: var(--wd-text);
  font-family: sans-serif;
  font-size: 12px;
  opacity: 0;
  transform: translateY(8px);
  pointer-events: none;
  transition: opacity 160ms ease, transform 160ms ease;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
}

.wd-toast.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.wd-toast[data-type="success"] .wd-toast-icon {
  color: var(--wd-success);
}

.wd-toast[data-type="error"] .wd-toast-icon {
  color: var(--wd-error);
}

@media (max-width: 900px) {
  .wd-decoder-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .wd-decoder-header-actions {
    width: 100%;
    justify-content: space-between;
  }

  .wd-decoder-grid {
    grid-template-columns: 1fr;
  }

  .wd-textarea-source,
  .wd-textarea-output {
    min-height: 320px;
  }
}
</style>

<div class="wd-decoder" id="wd-decoder-root" data-theme="dark">
  <div class="wd-decoder-header">
    <div>
      <h2 class="wd-decoder-title" data-i18n="appTitle">Codebox Safe Encoder / Decoder</h2>
      <div class="wd-decoder-subtitle" data-i18n="appSubtitle">
        Generate stable snippet:codebox payloads with lang-based syntax highlighting.
      </div>
    </div>

    <div class="wd-decoder-header-actions">
      <select class="wd-ui-lang-select" id="wd-ui-lang-select" aria-label="UI language">
        <option value="en">English</option>
        <option value="ko">한국어</option>
        <option value="ja">日本語</option>
        <option value="fr">Français</option>
        <option value="de">Deutsch</option>
        <option value="zh">中文</option>
        <option value="es">Español</option>
      </select>

      <label class="wd-theme-switch" id="wd-theme-toggle" aria-label="Toggle theme" title="Toggle theme">
        <input
          class="wd-theme-switch-input"
          id="wd-theme-switch-input"
          type="checkbox"
          role="switch"
          aria-label="Toggle light theme"
        />
        <span class="wd-theme-switch-track" aria-hidden="true">
          <span class="wd-theme-switch-icon material-symbols-outlined">dark_mode</span>
          <span class="wd-theme-switch-thumb"></span>
          <span class="wd-theme-switch-icon material-symbols-outlined">light_mode</span>
        </span>
      </label>
    </div>
  </div>

  <div class="wd-decoder-body">
    <div class="wd-note" data-i18n-html="note">
      <strong>Default:</strong> Plain Text.
      For <strong>lang=wikidot</strong>, square brackets are encoded.
      For all languages, HTML wrapper-sensitive characters are encoded.
    </div>

    <div class="wd-decoder-grid">
      <section class="wd-decoder-card">
        <div class="wd-decoder-card-header">
          <div class="wd-decoder-card-title" data-i18n="inputTitle">Input</div>
          <div class="wd-decoder-card-meta" data-i18n="inputMeta">raw source</div>
        </div>

        <div class="wd-decoder-controls">
          <div class="wd-field">
            <label class="wd-label" for="wd-title-input" data-i18n="includeTitle">Include Title</label>
            <textarea class="wd-textarea" id="wd-title-input" placeholder="Code"></textarea>
          </div>

          <div class="wd-field">
            <label class="wd-label" for="wd-lang-select" data-i18n="language">Language</label>
            <select class="wd-select" id="wd-lang-select">
              <option value="plaintext" selected>Plain Text</option>
              <option value="wikidot">Wikidot</option>
              <option value="html">HTML</option>
              <option value="css">CSS</option>
              <option value="javascript">JavaScript</option>
              <option value="typescript">TypeScript</option>
              <option value="python">Python</option>
              <option value="bash">Bash</option>
              <option value="yaml">YAML</option>
              <option value="json">JSON</option>
              <option value="markup">Markup</option>
            </select>
          </div>

          <div class="wd-field">
            <label class="wd-label" for="wd-source-input" data-i18n="sourceCode">Source Code</label>
            <textarea
              class="wd-textarea wd-textarea-source"
              id="wd-source-input"
              spellcheck="false"
              placeholder="Paste raw code here."
              data-i18n-placeholder="sourcePlaceholder"
            ></textarea>
          </div>

          <div class="wd-error-message" id="wd-error-message" data-i18n="emptyError">
            Source Code is empty. Paste code before generating output.
          </div>

          <div class="wd-actions">
            <button class="wd-button wd-button-primary" id="wd-generate-button" type="button">
              <span class="material-symbols-outlined" aria-hidden="true">bolt</span>
              <span data-i18n="generate">Generate</span>
            </button>

            <button class="wd-button" id="wd-decode-input-button" type="button">
              <span class="material-symbols-outlined" aria-hidden="true">data_object</span>
              <span data-i18n="decodeEntities">Decode entities</span>
            </button>

            <button class="wd-button wd-button-danger" id="wd-clear-button" type="button">
              <span class="material-symbols-outlined" aria-hidden="true">delete</span>
              <span data-i18n="clear">Clear</span>
            </button>
          </div>

          <div class="wd-token-chip-row">
            <span class="wd-chip wd-chip-accent">&amp; → &amp;amp;</span>
            <span class="wd-chip wd-chip-accent">&lt; → &amp;lt;</span>
            <span class="wd-chip wd-chip-accent">&gt; → &amp;gt;</span>
            <span class="wd-chip wd-chip-format">wikidot: [ ] → &amp;#91; &amp;#93;</span>
          </div>

          <div class="wd-stats">
            <span class="wd-stat"><span data-i18n="inputLines">Input lines</span>: <strong id="wd-input-lines">0</strong></span>
            <span class="wd-stat"><span data-i18n="inputChars">Input chars</span>: <strong id="wd-input-chars">0</strong></span>
          </div>
        </div>
      </section>

      <section class="wd-decoder-card">
        <div class="wd-decoder-card-header">
          <div class="wd-decoder-card-title" data-i18n="outputTitle">Output</div>
          <div class="wd-decoder-card-meta" data-i18n="outputMeta">copy into Wikidot page</div>
        </div>

        <div class="wd-decoder-controls">
          <div class="wd-field">
            <label class="wd-label" for="wd-output" data-i18n="generatedInclude">Generated Wikidot Include</label>
            <textarea
              class="wd-textarea wd-textarea-output"
              id="wd-output"
              spellcheck="false"
              readonly
              placeholder="Generated output appears here."
              data-i18n-placeholder="outputPlaceholder"
            ></textarea>
          </div>

          <div class="wd-actions">
            <button class="wd-button wd-button-success" id="wd-copy-output-button" type="button">
              <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
              <span data-i18n="copyOutput">Copy output</span>
            </button>

            <button class="wd-button" id="wd-copy-body-button" type="button">
              <span class="material-symbols-outlined" aria-hidden="true">subject</span>
              <span data-i18n="copyBody">Copy encoded body</span>
            </button>
          </div>

          <div class="wd-stats">
            <span class="wd-stat"><span data-i18n="outputLines">Output lines</span>: <strong id="wd-output-lines">0</strong></span>
            <span class="wd-stat"><span data-i18n="outputChars">Output chars</span>: <strong id="wd-output-chars">0</strong></span>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="wd-toast" id="wd-toast" data-type="success" aria-live="polite">
    <span class="material-symbols-outlined wd-toast-icon" id="wd-toast-icon" aria-hidden="true">check_circle</span>
    <span id="wd-toast-text">Copied</span>
  </div>
</div>

<script>
(function () {
  const root = document.getElementById("wd-decoder-root");
  const themeSwitchInput = document.getElementById("wd-theme-switch-input");
  const uiLangSelect = document.getElementById("wd-ui-lang-select");

  const titleInput = document.getElementById("wd-title-input");
  const langSelect = document.getElementById("wd-lang-select");
  const sourceInput = document.getElementById("wd-source-input");
  const output = document.getElementById("wd-output");
  const errorMessage = document.getElementById("wd-error-message");

  const generateButton = document.getElementById("wd-generate-button");
  const decodeInputButton = document.getElementById("wd-decode-input-button");
  const clearButton = document.getElementById("wd-clear-button");
  const copyOutputButton = document.getElementById("wd-copy-output-button");
  const copyBodyButton = document.getElementById("wd-copy-body-button");

  const inputLines = document.getElementById("wd-input-lines");
  const inputChars = document.getElementById("wd-input-chars");
  const outputLines = document.getElementById("wd-output-lines");
  const outputChars = document.getElementById("wd-output-chars");

  const toast = document.getElementById("wd-toast");
  const toastIcon = document.getElementById("wd-toast-icon");
  const toastText = document.getElementById("wd-toast-text");

  let toastTimer = null;
  let lastEncodedBody = "";
  let currentUiLang = "en";

  const translations = {
    en: {
      appTitle: "Codebox Safe Encoder / Decoder",
      appSubtitle: "Generate stable snippet:codebox payloads with lang-based syntax highlighting.",
      note: "<strong>Default:</strong> Plain Text. For <strong>lang=wikidot</strong>, square brackets are encoded. For all languages, HTML wrapper-sensitive characters are encoded.",
      inputTitle: "Input",
      inputMeta: "raw source",
      includeTitle: "Include Title",
      language: "Language",
      sourceCode: "Source Code",
      sourcePlaceholder: "Paste raw code here.",
      emptyError: "Source Code is empty. Paste code before generating output.",
      generate: "Generate",
      decodeEntities: "Decode entities",
      clear: "Clear",
      inputLines: "Input lines",
      inputChars: "Input chars",
      outputTitle: "Output",
      outputMeta: "copy into Wikidot page",
      generatedInclude: "Generated Wikidot Include",
      outputPlaceholder: "Generated output appears here.",
      copyOutput: "Copy output",
      copyBody: "Copy encoded body",
      outputLines: "Output lines",
      outputChars: "Output chars",
      toastGenerated: "Output generated",
      toastEmpty: "Source Code is empty",
      toastDecoded: "Input entities decoded",
      toastCleared: "Cleared",
      toastNothing: "Nothing to copy",
      toastOutputCopied: "Output copied",
      toastBodyCopied: "Encoded body copied",
      toastCopyFailed: "Copy failed"
    },
    ko: {
      appTitle: "Codebox 안전 인코더 / 디코더",
      appSubtitle: "lang 기반 syntax highlighting용 stable snippet:codebox payload를 생성합니다.",
      note: "<strong>기본값:</strong> Plain Text. <strong>lang=wikidot</strong>일 때 대괄호를 인코딩합니다. 모든 언어에서 HTML wrapper에 민감한 문자를 인코딩합니다.",
      inputTitle: "입력",
      inputMeta: "원본 소스",
      includeTitle: "Include 제목",
      language: "언어",
      sourceCode: "소스 코드",
      sourcePlaceholder: "원본 코드를 붙여넣으세요.",
      emptyError: "Source Code가 비어 있습니다. 출력 생성 전에 코드를 붙여넣으세요.",
      generate: "생성",
      decodeEntities: "엔티티 디코딩",
      clear: "지우기",
      inputLines: "입력 줄 수",
      inputChars: "입력 문자 수",
      outputTitle: "출력",
      outputMeta: "Wikidot 페이지에 복사",
      generatedInclude: "생성된 Wikidot Include",
      outputPlaceholder: "생성된 출력이 여기에 표시됩니다.",
      copyOutput: "출력 복사",
      copyBody: "인코딩 본문 복사",
      outputLines: "출력 줄 수",
      outputChars: "출력 문자 수",
      toastGenerated: "출력이 생성되었습니다",
      toastEmpty: "Source Code가 비어 있습니다",
      toastDecoded: "입력 엔티티를 디코딩했습니다",
      toastCleared: "지웠습니다",
      toastNothing: "복사할 내용이 없습니다",
      toastOutputCopied: "출력을 복사했습니다",
      toastBodyCopied: "인코딩 본문을 복사했습니다",
      toastCopyFailed: "복사 실패"
    },
    ja: {
      appTitle: "Codebox 安全エンコーダー / デコーダー",
      appSubtitle: "lang ベースの syntax highlighting 用 stable snippet:codebox payload を生成します。",
      note: "<strong>既定:</strong> Plain Text。<strong>lang=wikidot</strong> の場合は角括弧をエンコードします。すべての言語で HTML wrapper に影響する文字をエンコードします。",
      inputTitle: "入力",
      inputMeta: "元ソース",
      includeTitle: "Include タイトル",
      language: "言語",
      sourceCode: "ソースコード",
      sourcePlaceholder: "元コードを貼り付けてください。",
      emptyError: "Source Code が空です。出力を生成する前にコードを貼り付けてください。",
      generate: "生成",
      decodeEntities: "エンティティをデコード",
      clear: "クリア",
      inputLines: "入力行数",
      inputChars: "入力文字数",
      outputTitle: "出力",
      outputMeta: "Wikidot ページにコピー",
      generatedInclude: "生成された Wikidot Include",
      outputPlaceholder: "生成された出力がここに表示されます。",
      copyOutput: "出力をコピー",
      copyBody: "エンコード本文をコピー",
      outputLines: "出力行数",
