  function t(key) {
    return (translations[currentUiLang] && translations[currentUiLang][key]) ||
      translations.en[key] ||
      key;
  }

  function detectUiLang() {
    let saved = null;

    try {
      saved = localStorage.getItem("wd-codebox-decoder-ui-lang");
    } catch (error) {}

    if (saved && translations[saved]) {
      return saved;
    }

    const nav = String(navigator.language || "en").toLowerCase();

    if (nav.indexOf("ko") === 0) return "ko";
    if (nav.indexOf("ja") === 0) return "ja";
    if (nav.indexOf("fr") === 0) return "fr";
    if (nav.indexOf("de") === 0) return "de";
    if (nav.indexOf("zh") === 0) return "zh";
    if (nav.indexOf("es") === 0) return "es";

    return "en";
  }

  function applyUiLang(lang) {
    const next = translations[lang] ? lang : "en";
    currentUiLang = next;

    if (uiLangSelect) {
      uiLangSelect.value = next;
    }

    document.querySelectorAll("[data-i18n]").forEach(function (el) {
      el.textContent = t(el.getAttribute("data-i18n"));
    });

    document.querySelectorAll("[data-i18n-html]").forEach(function (el) {
      el.innerHTML = t(el.getAttribute("data-i18n-html"));
    });

    document.querySelectorAll("[data-i18n-placeholder]").forEach(function (el) {
      el.setAttribute("placeholder", t(el.getAttribute("data-i18n-placeholder")));
    });

    if (errorMessage.classList.contains("is-visible")) {
      errorMessage.textContent = t("emptyError");
    }

    try {
      localStorage.setItem("wd-codebox-decoder-ui-lang", next);
    } catch (error) {}
  }

  function getSavedTheme() {
    try {
      return localStorage.getItem("wd-codebox-theme");
    } catch (error) {
      return null;
    }
  }

  function saveTheme(theme) {
    try {
      localStorage.setItem("wd-codebox-theme", theme);
    } catch (error) {}
  }

  function createScrollSnapshot() {
    const active = document.activeElement;
    const windowScrollX = window.scrollX || window.pageXOffset || 0;
    const windowScrollY = window.scrollY || window.pageYOffset || 0;
    const bodyScrollTop = document.body ? document.body.scrollTop : 0;
    const bodyScrollLeft = document.body ? document.body.scrollLeft : 0;
    const docScrollTop = document.documentElement ? document.documentElement.scrollTop : 0;
    const docScrollLeft = document.documentElement ? document.documentElement.scrollLeft : 0;

    return function restoreScroll() {
      if (document.body) {
        document.body.scrollTop = bodyScrollTop;
        document.body.scrollLeft = bodyScrollLeft;
      }

      if (document.documentElement) {
        document.documentElement.scrollTop = docScrollTop;
        document.documentElement.scrollLeft = docScrollLeft;
      }

      window.scrollTo(windowScrollX, windowScrollY);

      if (active && typeof active.focus === "function") {
        try {
          active.focus({ preventScroll: true });
        } catch (error) {}
      }
    };
  }

  function restoreScrollLater(restoreScroll) {
    restoreScroll();

    requestAnimationFrame(function () {
      restoreScroll();

      requestAnimationFrame(function () {
        restoreScroll();
      });
    });

    setTimeout(restoreScroll, 80);
  }

  function applyTheme(theme, restoreScroll) {
    const nextTheme = theme === "light" ? "light" : "dark";

    root.setAttribute("data-theme", nextTheme);

    if (themeSwitchInput) {
      themeSwitchInput.checked = nextTheme === "light";
      themeSwitchInput.setAttribute(
        "aria-checked",
        nextTheme === "light" ? "true" : "false"
      );
    }

    if (restoreScroll) {
      restoreScrollLater(restoreScroll);
    }
  }

  function toggleTheme() {
    const restoreScroll = createScrollSnapshot();
    const next = themeSwitchInput && themeSwitchInput.checked ? "light" : "dark";

    applyTheme(next, restoreScroll);
    saveTheme(next);
  }

  function showToast(type, message) {
    if (!toast || !toastIcon || !toastText) {
      return;
    }

    if (toastTimer) {
      clearTimeout(toastTimer);
    }

    toastIcon.textContent = type === "error" ? "error" : "check_circle";
    toast.setAttribute("data-type", type === "error" ? "error" : "success");
    toastText.textContent = message;
    toast.classList.add("is-visible");

    toastTimer = setTimeout(function () {
      toast.classList.remove("is-visible");
    }, 2600);
  }

  function showEmptyError() {
    errorMessage.textContent = t("emptyError");
    errorMessage.classList.add("is-visible");
    showToast("error", t("toastEmpty"));
  }

  function hideEmptyError() {
    errorMessage.classList.remove("is-visible");
  }

  function countLines(text) {
    const value = String(text || "");
    return value.length ? value.split(/\r\n|\r|\n/).length : 0;
  }

  function updateStats() {
    const sourceText = sourceInput.value || "";
    const outputText = output.value || "";

    inputLines.textContent = countLines(sourceText);
    inputChars.textContent = sourceText.length;
    outputLines.textContent = countLines(outputText);
    outputChars.textContent = outputText.length;
  }

  function normalizeLang(value) {
    const lang = String(value || "plaintext").toLowerCase().trim();
    return lang || "plaintext";
  }

  function sanitizeTitle(value) {
    const title = String(value || "")
      .replace(/\r?\n/g, " ")
      .replace(/\|/g, "｜")
      .replace(/\s+/g, " ")
      .trim();

    return title || "Code";
  }

  function encodeBaseEntities(text) {
    return String(text || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  function encodeWikidotBrackets(text) {
    return String(text || "")
      .replace(/\[/g, "&#91;")
      .replace(/\]/g, "&#93;");
  }

  function encodeForCodebox(text, lang) {
    const normalizedLang = normalizeLang(lang);
    let result = encodeBaseEntities(text);

    if (normalizedLang === "wikidot" || normalizedLang === "wd" || normalizedLang === "wiki") {
      result = encodeWikidotBrackets(result);
    }

    return result;
  }

  function decodeEntities(text) {
    const temp = document.createElement("textarea");
    temp.innerHTML = String(text || "");
    return temp.value;
  }

  function buildInclude(title, lang, encodedBody) {
    return [
      "[[include snippet:codebox",
      "|title=" + title,
      "|lang=" + lang,
      "]]",
      "",
      encodedBody,
      "",
      "[[include snippet:codebox-end]]"
    ].join("\n");
  }

  function clearGeneratedOutput() {
    output.value = "";
    lastEncodedBody = "";
    updateStats();
  }

  function generateOutput(options) {
    const silent = options && options.silent;
    const source = sourceInput.value || "";

    if (!source.trim()) {
      clearGeneratedOutput();

      if (!silent) {
        showEmptyError();
      }

      return false;
    }

    hideEmptyError();

    const title = sanitizeTitle(titleInput.value);
    const lang = normalizeLang(langSelect.value);
    const encodedBody = encodeForCodebox(source, lang);
    const generated = buildInclude(title, lang, encodedBody);

    lastEncodedBody = encodedBody;
    output.value = generated;
    updateStats();

    if (!silent) {
      showToast("success", t("toastGenerated"));
    }

    return true;
  }

  function decodeInputEntities() {
    if (!sourceInput.value.trim()) {
      showEmptyError();
      return;
    }

    sourceInput.value = decodeEntities(sourceInput.value);
    generateOutput({ silent: true });
    showToast("success", t("toastDecoded"));
  }

  function clearAll() {
    titleInput.value = "";
    sourceInput.value = "";
    output.value = "";
    lastEncodedBody = "";
    hideEmptyError();
    updateStats();
    showToast("success", t("toastCleared"));
  }

  function copyWithFallback(text) {
    const temp = document.createElement("textarea");

    temp.value = text;
    temp.setAttribute("readonly", "readonly");
    temp.setAttribute("aria-hidden", "true");
    temp.style.position = "fixed";
    temp.style.left = "0";
    temp.style.top = "0";
    temp.style.width = "1px";
    temp.style.height = "1px";
    temp.style.opacity = "0";
    temp.style.pointerEvents = "none";
    temp.style.zIndex = "-1";

    document.body.appendChild(temp);

    try {
      temp.focus({ preventScroll: true });
    } catch (error) {
      temp.focus();
    }

    temp.select();
    temp.setSelectionRange(0, temp.value.length);

    const result = document.execCommand("copy");
    document.body.removeChild(temp);

    return result;
  }

  async function copyText(text, message) {
    const value = String(text || "");
    const restoreScroll = createScrollSnapshot();

    if (!value) {
      restoreScrollLater(restoreScroll);
      showToast("error", t("toastNothing"));
      return;
    }

    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(value);
      } else {
        copyWithFallback(value);
      }

      restoreScrollLater(restoreScroll);
      showToast("success", message);
    } catch (error) {
      restoreScrollLater(restoreScroll);
      showToast("error", t("toastCopyFailed"));
    }
  }

  function copyOutput() {
    const restoreScroll = createScrollSnapshot();

    if (!output.value) {
      const generated = generateOutput({ silent: true });

      restoreScrollLater(restoreScroll);

      if (!generated) {
        showEmptyError();
        return;
      }
    }

    copyText(output.value, t("toastOutputCopied"));
  }

  function copyEncodedBody() {
    const restoreScroll = createScrollSnapshot();

    if (!lastEncodedBody) {
      const generated = generateOutput({ silent: true });

      restoreScrollLater(restoreScroll);

      if (!generated) {
        showEmptyError();
        return;
      }
    }

    copyText(lastEncodedBody, t("toastBodyCopied"));
  }

  function initTheme() {
    const restoreScroll = createScrollSnapshot();

    applyTheme(getSavedTheme() || "dark", restoreScroll);

    if (themeSwitchInput) {
      themeSwitchInput.addEventListener("change", toggleTheme);
    }
  }

  function bindEvents() {
    [
      generateButton,
      decodeInputButton,
      clearButton,
      copyOutputButton,
      copyBodyButton
    ].forEach(function (button) {
      button.addEventListener("mousedown", function (event) {
        event.preventDefault();
      });
    });

    uiLangSelect.addEventListener("change", function () {
      const restoreScroll = createScrollSnapshot();
      applyUiLang(uiLangSelect.value);
      restoreScrollLater(restoreScroll);
    });

    generateButton.addEventListener("click", function () {
      generateOutput({ silent: false });
    });

    decodeInputButton.addEventListener("click", decodeInputEntities);
    clearButton.addEventListener("click", clearAll);
    copyOutputButton.addEventListener("click", copyOutput);
    copyBodyButton.addEventListener("click", copyEncodedBody);

    titleInput.addEventListener("input", function () {
      generateOutput({ silent: true });
    });

    langSelect.addEventListener("change", function () {
      generateOutput({ silent: true });
    });

    sourceInput.addEventListener("input", function () {
      if (sourceInput.value.trim()) {
        hideEmptyError();
        generateOutput({ silent: true });
      } else {
        clearGeneratedOutput();
      }
    });
  }

  applyUiLang(detectUiLang());
  initTheme();
  bindEvents();
  updateStats();
})();
</script>
[[/html]]
